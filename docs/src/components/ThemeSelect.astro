---
// ThemeSelect override — replaces the default <select> with a minimal icon toggle button.
// Integrates with Starlight's ThemeProvider: reads/writes localStorage 'starlight-theme'
// and document.documentElement.dataset.theme.
---

<starlight-theme-select>
	<button
		type="button"
		class="theme-toggle"
		aria-label="Toggle theme"
		title="Toggle theme"
	>
		<!-- Sun icon: visible in dark mode — click to switch to light -->
		<svg
			class="icon-sun"
			xmlns="http://www.w3.org/2000/svg"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="1.5"
			stroke-linecap="round"
			stroke-linejoin="round"
			aria-hidden="true"
		>
			<circle cx="12" cy="12" r="4"></circle>
			<path d="M12 2v3M12 19v3M4.22 4.22l2.12 2.12M17.66 17.66l2.12 2.12M2 12h3M19 12h3M4.22 19.78l2.12-2.12M17.66 6.34l2.12-2.12"></path>
		</svg>

		<!-- Moon icon: visible in light mode — click to switch to dark -->
		<svg
			class="icon-moon"
			xmlns="http://www.w3.org/2000/svg"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="1.5"
			stroke-linecap="round"
			stroke-linejoin="round"
			aria-hidden="true"
		>
			<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
		</svg>
	</button>
</starlight-theme-select>

<style>
	.theme-toggle {
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 0;
		border: none;
		background: transparent;
		color: var(--sl-color-text-accent);
		cursor: pointer;
		flex-shrink: 0;
		transition: color 0.15s ease;
	}

	.theme-toggle:hover {
		color: var(--sl-color-text);
	}

	.icon-sun,
	.icon-moon {
		display: none;
		width: 18px;
		height: 18px;
	}

	/* Dark mode: show sun (clicking goes to light) */
	:root[data-theme='dark'] .icon-sun {
		display: block;
	}

	/* Light mode: show moon (clicking goes to dark) */
	:root[data-theme='light'] .icon-moon {
		display: block;
	}

	/* System preference fallback before ThemeProvider has run */
	@media (prefers-color-scheme: dark) {
		:root:not([data-theme]) .icon-sun {
			display: block;
		}
	}
	@media (prefers-color-scheme: light) {
		:root:not([data-theme]) .icon-moon {
			display: block;
		}
	}
</style>

<script>
	const storageKey = 'starlight-theme';

	class StarlightThemeSelect extends HTMLElement {
		constructor() {
			super();
			const btn = this.querySelector<HTMLButtonElement>('button');
			if (!btn) return;

			this.#updateLabel(btn);

			btn.addEventListener('click', () => {
				const current = document.documentElement.dataset.theme as 'dark' | 'light' | undefined;
				const isDark =
					current === 'dark' ||
					(!current && window.matchMedia('(prefers-color-scheme: dark)').matches);
				const next = isDark ? 'light' : 'dark';

				document.documentElement.dataset.theme = next;
				localStorage.setItem(storageKey, next);
				this.#updateLabel(btn);
			});
		}

		#updateLabel(btn: HTMLButtonElement) {
			const theme = document.documentElement.dataset.theme;
			btn.setAttribute(
				'aria-label',
				theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode',
			);
		}
	}

	customElements.define('starlight-theme-select', StarlightThemeSelect);
</script>
